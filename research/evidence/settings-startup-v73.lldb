register write x0 0x781f00c3c0
breakpoint command add -o 'register write x0 0x781f00c3c0' 1
breakpoint modify --auto-continue true 1
breakpoint set -H -a 0x10454f70c
breakpoint command add -o 'register write x1 0x781f00c3c0' 2
breakpoint modify --auto-continue true 2
breakpoint set -H -a 0x184744138
breakpoint command add -o 'memory write -s 1 0x1e3fdf9d8 1' 3
breakpoint modify --auto-continue true 3
breakpoint set -H -a 0x1847614b8
breakpoint command add -o 'register write x8 0x1e9017900' 4
breakpoint modify --auto-continue true 4
breakpoint set -H -a 0x1bb66a120
breakpoint command add 5
register write w0 0xffffffff
register write pc 0x1bb66a124
DONE
breakpoint modify --auto-continue true 5
breakpoint set -H -a 0x2258565f0 -c '*(unsigned int*)((*(unsigned long long*)(($x24 & 0x00ffffffffffffff)+8)&0x00ffffffffffffff)+0x68)==1'
breakpoint command add -o 'register write x0 0' 6
breakpoint modify --auto-continue true 6
