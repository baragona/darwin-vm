breakpoint modify -G true 9
breakpoint set -H -o true -a 0x187087978 -c '$x22 == 416 && $x0 == 496'
breakpoint command add -s python -o "frame.FindRegister('x22').SetValueFromCString('832'); frame.FindRegister('x0').SetValueFromCString('1808'); return False" 10
breakpoint set -H -a 0x182d30328
continue
