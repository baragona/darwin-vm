     } else {
         args.memSize = info->dram_size;
     }
+    if (info->boot_display) {
+        info->framebuffer_base = blob_head;
+        blob_head += ROUND_NEXT_PAGE(DARWIN_FB_SIZE);
+        if (blob_head > info->dram_base + args.memSize) {
+            fprintf(stderr, "boot framebuffer exceeds usable guest RAM\n");
+            exit(1);
+        }
+        /* Prototype: keep the extra pages covered by an SPTM-known range. */
+        set_adt_mmap(map, "RAMDisk", rd_base_phys, blob_head - rd_base_phys);
+        args.Video = (Boot_Video) {
+            .v_baseAddr = info->framebuffer_base,
+            .v_display = 0,
+            .v_rowBytes = DARWIN_FB_STRIDE,
+            .v_width = DARWIN_FB_WIDTH,
+            .v_height = DARWIN_FB_HEIGHT,
+            .v_depth = 32,
+        };
+        fprintf(stderr, "darwin boot framebuffer: 0x%llx, %dx%d, stride %d\n",
+                (unsigned long long)info->framebuffer_base,
+                DARWIN_FB_WIDTH, DARWIN_FB_HEIGHT, DARWIN_FB_STRIDE);
+    }
     args.topOfKernelData = blob_head;
     args.deviceTreeP = dtree_base_phys - args.physBase + args.virtBase;
     args.deviceTreeLength = info->dtree_f.len;
