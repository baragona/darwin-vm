diff --git a/hw/arm/darwin.c b/hw/arm/darwin.c
index 51d240b..5836efe 100644
--- a/hw/arm/darwin.c
+++ b/hw/arm/darwin.c
@@ -21,6 +21,8 @@
 #include "hw/arm/apple_amcc.h"
 #include "xnu/patch.h"
 #include "xnu/macho.h"
+#include "ui/console.h"
+#include "qemu/error-report.h"
 
 // See device tree specification section 2.3.8: ranges
 #define IO_RANGE_BASE_OFFSET     1
@@ -42,6 +44,33 @@ struct DarwinState {
     MachineState parent_obj;
     ARMCPU *cpu;
     struct xnu_boot_info bootinfo;
+    QemuConsole *boot_console;
+};
+
+static bool darwin_get_boot_display(Object *obj, Error **errp)
+{
+    return DARWIN_MACHINE(obj)->bootinfo.boot_display;
+}
+
+static void darwin_set_boot_display(Object *obj, bool value, Error **errp)
+{
+    DARWIN_MACHINE(obj)->bootinfo.boot_display = value;
+}
+
+static bool darwin_display_update(void *opaque)
+{
+    DarwinState *s = opaque;
+    DisplaySurface *surface = qemu_console_surface(s->boot_console);
+
+    address_space_read(&address_space_memory, s->bootinfo.framebuffer_base,
+                       MEMTXATTRS_UNSPECIFIED, surface_data(surface),
+                       DARWIN_FB_SIZE);
+    qemu_console_update_full(s->boot_console);
+    return true;
+}
+
+static const GraphicHwOps darwin_display_ops = {
+    .gfx_update = darwin_display_update,
 };
 
 MACHINE_CLASS_ARG(bootkc);
@@ -257,6 +286,15 @@ static void darwin_init(MachineState *ms) {
 
     s->cpu = ARM_CPU(cpuobj);
     arm_load_xnu(s->cpu, ms, info);
+    if (info->boot_display) {
+        if (!info->framebuffer_base) {
+            error_report("boot-display currently requires an SPTM kernel");
+            exit(1);
+        }
+        s->boot_console = qemu_graphic_console_create(NULL, 0,
+                                                      &darwin_display_ops, s);
+        qemu_console_resize(s->boot_console, DARWIN_FB_WIDTH, DARWIN_FB_HEIGHT);
+    }
     if (info->has_mte) setup_mte(cpuobj, MACHINE(s), info);
 
     struct dtree_node *amcc_node = adt_find_node(dt_root, "chosen/lock-regs/amcc");
@@ -306,6 +344,9 @@ static void darwin_machine_init(MachineClass *mc) {
